{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FirebaseBlueprint",
  "description": "Schema definition for La Tierrita Firebase integration",
  "entities": {
    "UserProfile": {
      "collection": "users",
      "description": "User profile records",
      "fields": {
        "id": { "type": "string", "description": "Auth UID" },
        "email": { "type": "string", "description": "User email" },
        "username": { "type": "string", "description": "Unique username" },
        "name": { "type": "string", "description": "Full name" },
        "firstName": { "type": "string", "description": "User first name" },
        "lastName": { "type": "string", "description": "User last name" },
        "birthDate": { "type": "string", "description": "Birth date (DD/MM/YYYY)" },
        "age": { "type": "number", "description": "User age (minimum 18)" },
        "avatar": { "type": "string", "description": "Avatar URL" },
        "bio": { "type": "string", "description": "Short bio" },
        "website": { "type": "string", "description": "Website or social link" },
        "city": { "type": "string", "description": "City in Spain" },
        "originCity": { "type": "string", "description": "City of origin in Colombia" },
        "followersCount": { "type": "number", "description": "Follower count" },
        "followingCount": { "type": "number", "description": "Following count" },
        "postsCount": { "type": "number", "description": "Posts count" },
        "isVerified": { "type": "boolean", "description": "Verified badge" },
        "staffRole": { "type": "string", "description": "Role: Usuario, MOD, Soporte, ADMIN" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      }
    },
    "Post": {
      "collection": "posts",
      "description": "User shared posts and community pictures",
      "fields": {
        "id": { "type": "string", "description": "Post ID" },
        "userId": { "type": "string", "description": "Author UID" },
        "username": { "type": "string", "description": "Author username" },
        "userAvatar": { "type": "string", "description": "Author avatar URL" },
        "userCity": { "type": "string", "description": "Author city" },
        "mediaUrl": { "type": "string", "description": "Media URL" },
        "caption": { "type": "string", "description": "Post description" },
        "location": { "type": "string", "description": "Location tag" },
        "likesCount": { "type": "number", "description": "Number of likes" },
        "timestamp": { "type": "string", "description": "ISO timestamp" }
      }
    },
    "Story": {
      "collection": "stories",
      "description": "Ephemeral 24h stories",
      "fields": {
        "id": { "type": "string", "description": "Story ID" },
        "userId": { "type": "string", "description": "Author UID" },
        "username": { "type": "string", "description": "Author username" },
        "userAvatar": { "type": "string", "description": "Author avatar" },
        "userCity": { "type": "string", "description": "City" },
        "mediaUrl": { "type": "string", "description": "Media URL" },
        "caption": { "type": "string", "description": "Caption" },
        "timestamp": { "type": "string", "description": "ISO timestamp" }
      }
    },
    "DeletedAccount": {
      "collection": "deleted_accounts",
      "description": "Deleted and suspended accounts retained for 7 days",
      "fields": {
        "id": { "type": "string", "description": "Record ID" },
        "userId": { "type": "string", "description": "User ID" },
        "username": { "type": "string", "description": "Username reserved" },
        "name": { "type": "string", "description": "Full name" },
        "email": { "type": "string", "description": "User email" },
        "avatar": { "type": "string", "description": "Avatar URL" },
        "deletedAt": { "type": "string", "description": "Timestamp of deletion" },
        "retentionExpiresAt": { "type": "string", "description": "Expiration timestamp (+7 days)" },
        "reason": { "type": "string", "description": "Reason for deletion/suspension" },
        "canRestore": { "type": "boolean", "description": "Whether account is restorable" }
      }
    },
    "SupportTicket": {
      "collection": "support_tickets",
      "description": "Sequential auto-numbered customer support and moderation reports",
      "fields": {
        "id": { "type": "string", "description": "Ticket unique document ID" },
        "code": { "type": "string", "description": "Sequential assigned code (e.g. TS-0001)" },
        "type": { "type": "string", "description": "Category: TS, TRU, TRP, TRH, TRM, TRG" },
        "userName": { "type": "string", "description": "Ticket submitter name" },
        "userUsername": { "type": "string", "description": "Ticket submitter username" },
        "userAvatar": { "type": "string", "description": "Ticket submitter avatar url" },
        "subject": { "type": "string", "description": "Ticket title or subject" },
        "description": { "type": "string", "description": "Ticket content and report details" },
        "status": { "type": "string", "description": "Status: pendientes, en_proceso, resueltos" },
        "priority": { "type": "string", "description": "Priority: Baja, Media, Alta" },
        "date": { "type": "string", "description": "Submission ISO date" },
        "response": { "type": "string", "description": "Staff feedback/response" }
      }
    },
    "AdBanner": {
      "collection": "banners",
      "description": "Public advertising banners displayed in Inicio and Explorar carousels",
      "fields": {
        "id": { "type": "string", "description": "Banner ID" },
        "title": { "type": "string", "description": "Banner title" },
        "subtitle": { "type": "string", "description": "Short description" },
        "imageUrl": { "type": "string", "description": "Banner image URL" },
        "sponsorName": { "type": "string", "description": "Sponsor name" },
        "sponsorCity": { "type": "string", "description": "Sponsor city" },
        "ctaText": { "type": "string", "description": "Button call to action text" },
        "ctaLink": { "type": "string", "description": "Destination link URL" },
        "category": { "type": "string", "description": "Category" },
        "carouselType": { "type": "string", "description": "Type: inicio, explorar, ambos" },
        "discountBadge": { "type": "string", "description": "Optional badge" },
        "active": { "type": "boolean", "description": "Active status" }
      }
    },
    "ClassifiedAd": {
      "collection": "classified_ads",
      "description": "User submitted classified advertisements",
      "fields": {
        "id": { "type": "string", "description": "Classified Ad unique ID" },
        "userId": { "type": "string", "description": "Creator User ID" },
        "title": { "type": "string", "description": "Ad title" },
        "category": { "type": "string", "description": "Category" },
        "city": { "type": "string", "description": "City in Spain or Toda España" },
        "description": { "type": "string", "description": "Ad description (max 100 chars)" },
        "contactName": { "type": "string", "description": "Contact person name" },
        "contactUsername": { "type": "string", "description": "Contact username" },
        "contactPhone": { "type": "string", "description": "Phone number" },
        "whatsapp": { "type": "string", "description": "WhatsApp contact number" },
        "price": { "type": "string", "description": "Price if applicable" },
        "imageUrl": { "type": "string", "description": "Ad image/logo url" },
        "date": { "type": "string", "description": "Human readable date label" },
        "createdAt": { "type": "number", "description": "Creation timestamp epoch" },
        "isPromoted": { "type": "boolean", "description": "Promoted flag" }
      }
    },
    "PlaceSuggestion": {
      "collection": "place_suggestions",
      "description": "User suggested place submissions sent to Support for review and approval",
      "fields": {
        "id": { "type": "string", "description": "Suggestion document ID" },
        "userId": { "type": "string", "description": "Suggesting user ID" },
        "userName": { "type": "string", "description": "Suggesting user name" },
        "userUsername": { "type": "string", "description": "Suggesting user username" },
        "userAvatar": { "type": "string", "description": "Suggesting user avatar URL" },
        "code": { "type": "string", "description": "Sequential suggestion code (e.g. SUG-001)" },
        "placeName": { "type": "string", "description": "Name of suggested place" },
        "category": { "type": "string", "description": "Place category" },
        "city": { "type": "string", "description": "City in Spain" },
        "address": { "type": "string", "description": "Place address" },
        "inGoogleMaps": { "type": "boolean", "description": "Whether location appears in Google Maps" },
        "phone": { "type": "string", "description": "Optional contact phone number" },
        "description": { "type": "string", "description": "Optional description max 100 chars" },
        "imageUrl": { "type": "string", "description": "Optional image/logo URL" },
        "website": { "type": "string", "description": "Optional website URL" },
        "status": { "type": "string", "description": "Status: pendientes, en_proceso, aprobado, rechazado" },
        "date": { "type": "string", "description": "Submission date string" },
        "createdAt": { "type": "number", "description": "Creation timestamp epoch" },
        "chatRoomId": { "type": "string", "description": "ID of associated support chat room" },
        "assignedStaffName": { "type": "string", "description": "Staff member name assigned" },
        "assignedStaffRole": { "type": "string", "description": "Staff member role" }
      }
    }
  }
}

